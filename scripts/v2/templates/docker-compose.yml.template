networks:
  blockchain-net:
    driver: bridge

services:
  # Metrics Server
  metrics-server:
    image: ${METRICS_IMAGE:-wasix-eth-metrics:latest}
    # Fallback to build if image not found or requested
    ${METRICS_BUILD_SECTION:-# No build section}
    ports:
      - "9100:9100"
    volumes:
      - ./metrics_server/data:/app/data
    networks:
      - blockchain-net

# Individual node services will be appended here by the generator script
