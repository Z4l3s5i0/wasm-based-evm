    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "process_resident_memory_bytes{node=~\"$node\"}",
          "legendFormat": "{{instance}} ({{executor_type}})",
          "refId": "A"
        }
      ],
      "title": "Memory Usage (Resident Set Size)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (executor) (rate(cpu_cycles_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{executor}} CPU Cycles/sec",
          "refId": "A"
        }
      ],
      "title": "CPU Cycle Efficiency",
      "type": "timeseries"
    }
  ],
