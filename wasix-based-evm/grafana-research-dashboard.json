      "id": 100,
      "title": "🔬 Execution Profiling (Headline Row)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (executor) (rate(execution_time_vs_workload_sum{node=~\"$node\"}[5m])) / sum by (executor) (rate(execution_time_vs_workload_count{node=~\"$node\"}[5m]))",
          "legendFormat": "{{executor}} Avg Exec Time",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Avg Execution Time by Executor",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (executor) (rate(instruction_count_total{node=~\"$node\"}[5m])) / sum by (executor) (rate(gas_used_per_block{node=~\"$node\"}[5m]))",
          "legendFormat": "{{executor}} Instructions/Gas",
          "refId": "A"
        }
      ],
      "title": "Instruction Density (Instructions per Gas)",
      "type": "timeseries"
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "title": "⚡ Latency & Determinism",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, executor) (rate(execution_latency_cdf_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "{{executor}} p99 Latency",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, executor) (rate(execution_latency_cdf_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "{{executor}} p50 Latency",
          "refId": "B"
        }
      ],
      "title": "Execution Latency Distribution (CDF)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (executor) (rate(wasm_compilation_seconds_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{executor}} Init Overhead",
          "refId": "A"
        }
      ],
      "title": "WASM Initialization/Compilation Overhead",
      "type": "timeseries"
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "title": "💾 Resource Footprint",
