# Dockerfile.windows
# Assuming binary is already built at wasix_eth/target/release/wasix_eth.exe
FROM debian:bookworm-slim

WORKDIR /app

# Install Wine
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends wine wine32 wine64 libwine libwine:i386 fonts-wine && \
    rm -rf /var/lib/apt/lists/*

# Copy the pre-built binary
COPY target/release/wasix_eth.exe /app/wasix_eth.exe

# Set the entrypoint to run with Wine
# We use /usr/bin/wine directly. Some systems might need wine64 or wine.
# We also set WINEDEBUG=-all to reduce noise.
ENV WINEDEBUG=-all
ENTRYPOINT ["/usr/bin/wine", "/app/wasix_eth.exe"]
