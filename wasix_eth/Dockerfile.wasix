# Dockerfile.wasix
FROM rust:1.80-slim-bookworm AS builder

WORKDIR /usr/src/wasix_eth

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install cargo-wasix
RUN cargo install cargo-wasix

# Copy the entire workspace
COPY . .

# Build Wasix binary
RUN cargo wasix build --release -p wasix_eth_app

# Runtime stage using Wasmer
FROM debian:bookworm-slim

WORKDIR /app

# Install Wasmer
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN curl https://get.wasmer.io -sSfL | sh
ENV PATH="/root/.wasmer/bin:${PATH}"

# Copy the .wasm file from the builder stage
COPY --from=builder /usr/src/wasix_eth/target/wasm32-wasmer-wasi/release/wasix_eth_app.wasm /app/wasix_eth.wasm

# Set the entrypoint to run with Wasmer
ENTRYPOINT ["wasmer", "run", "/app/wasix_eth.wasm", "--enable-threads", "--net", "--"]
